<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Dòng 1: Mã + Icon sửa/xóa -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvMa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="R001"
                android:textColor="@android:color/darker_gray"
                android:textSize="12sp" />

            <!-- LinearLayout chứa icon sửa/xóa - đặt TRƯỚC -->
            <LinearLayout
                android:id="@+id/actionButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnEdit"
                    android:layout_width="20dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_edit"
                    android:scaleType="centerInside"
                    android:visibility="visible"
                    app:tint="@color/purple_500" />
<!--                <TextView-->
<!--                    android:id="@+id/btnEdit"-->
<!--                    android:layout_width="30dp"-->
<!--                    android:layout_height="30dp"-->
<!--                    android:gravity="center"-->
<!--                    android:text="✎"-->
<!--                    android:textColor="@color/purple_500"-->
<!--                    android:textSize="18sp"-->
<!--                    android:visibility="visible" />-->

<!--                <TextView-->
<!--                    android:id="@+id/btnDelete"-->
<!--                    android:layout_width="30dp"-->
<!--                    android:layout_height="30dp"-->
<!--                    android:gravity="center"-->
<!--                    android:text="🗑️"-->
<!--                    android:textColor="#FF0000"-->
<!--                    android:textSize="18sp"-->
<!--                    android:visibility="visible" />-->

                <ImageButton
                    android:id="@+id/btnDelete"
                    android:layout_width="15dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/ic_delete"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    app:tint="#5A5757" />

            </LinearLayout>

            <!-- CheckBox đặt SAU, tham chiếu đến ID đã có -->
            <CheckBox
                android:id="@+id/checkBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/actionButtons"
                android:layout_centerVertical="true"
                android:visibility="gone" />

        </RelativeLayout>

        <TextView
            android:id="@+id/tvTen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Điện trở 100Ω"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Điện trở"
            android:textColor="@android:color/tertiary_text_dark"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="6">

            <TextView
                android:id="@+id/tvSoLuong"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="50 cái"
                android:textColor="@color/teal_700"
                android:textSize="14sp"
                android:drawablePadding="4dp" />

            <TextView
                android:id="@+id/tvGia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:gravity="end"
                android:text="500 VNĐ"
                android:textColor="@color/purple_500"
                android:textSize="14sp" />



            <EditText
                android:id="@+id/edtQuantity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:background="@drawable/edit_text_border"
                android:gravity="center"
                android:inputType="number"
                android:maxLines="1"
                android:padding="4dp"
                android:text="0"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>